{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "types": [
      "@cloudflare/workers-types"
    ],
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next-smoke/types/**/*.ts",
    ".next-smoke/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next-smoke",
    "worker",
    "vite.config.ts",
    "android",
    "android-shell",
    "scripts",
    ".tmp",
    "tmp",
    "dist",
    "output",
    "outputs",
    "artifacts",
    "lorewise-universe-android-fresh",
    "famigli-del-nexus",
    ".netlify",
    ".wrangler",
    ".npm-cache",
    ".tools"
  ]
}
